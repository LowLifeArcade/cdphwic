{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cdphwic",
    "main": "./.output/server/index.mjs",
    "compatibility_date": "2026-10-07",
    "assets": {
        "binding": "ASSETS",
        "directory": "./.output/public/"
    },
    "workers_dev": true,
    "preview_urls": true,
    "observability": {
        "enabled": true
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "vars": {
        "ENV": "prod"
    },
    "d1_databases": [
        {
            "binding": "CDPHWIC",
            "database_name": "cdphwic",
            "database_id": "ec695ffd-80be-493b-8853-cabe4d5425d0",
            "migrations_dir": "db/migrations",
            "remote": true
        }
    ],
    "env": {
        "dev": {
            "vars": {
                "ENV": "dev"
            },
            "d1_databases": [
                {
                    "binding": "CDPHWIC",
                    "database_name": "cdphwic-db-dev",
                    "database_id": "00000000-0000-0000-0000-000000000000",
                    "migrations_dir": "db/migrations"
                }
            ]
        }
    }
}